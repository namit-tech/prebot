{
  "name": "prebot",
  "version": "1.0.12",
  "main": "main.js",
  "description": "PreBot - Offline AI Assistant",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../electron && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "cd electron && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "cd electron && npm run build",
    "init:modules": "cd backend && npm run init:modules",
    "deploy:vps": "cd backend && ./deploy.sh",
    "build-win": "node scripts/build-win-robust.js",
    "lint": "eslint main.js preload.js whisper-handler.js whisper-setup.js stt-handler.js ollama-setup.js embedded-backend.js frontend/src",
    "lint:fix": "eslint main.js preload.js whisper-handler.js whisper-setup.js stt-handler.js ollama-setup.js embedded-backend.js frontend/src --fix"
  },
  "keywords": [
    "electron",
    "ai",
    "assistant"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^2.2.4",
    "three": "^0.182.0",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "electron": "^27.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.39.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0"
  },
  "build": {
    "compression": "store",
    "appId": "com.prebot.offline",
    "productName": "Offline AI Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!backend",
      "!frontend",
      "!electron",
      "!screens",
      "!*.md",
      "!*.bat",
      "!dist",
      "!dist_build",
      "!resources/installers/OllamaSetup.exe",
      "!android/**/*",
      "!www/**/*",
      "!**/.git",
      "!assets/videos/**/*",
      "!assets/**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName} ${version} ${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName} Setup ${version} ${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version} ${arch}.${ext}"
    }
  }
}
